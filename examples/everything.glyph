# ─────────────────────────────────────────
# example.cfg — Comprehensive example file
# ─────────────────────────────────────────

# ── App metadata ──────────────────────────

app: {
  name: "MyApp"
  version: "2.4.1"
  debug: false
  port: 8080
  max_connections: 200
  timeout: 30.5
  description: null
}

# ── Database configuration ────────────────

database: {
  host: "localhost"
  port: 5432
  name: "myapp_db"
  user: "admin"
  password: "s3cr3t"
  ssl: true
  pool_size: 10
  idle_timeout: 600.0
  replica: null

  # Connection retry settings
  retry: {
    enabled: true
    attempts: 3
    delay: 1.5
  }
}

# ── Authentication ────────────────────────

auth: {
  enabled: true
  session_duration: 86400
  require_email_verification: true
  allow_guest: false
  secret: "change-me-in-production"

  # Supported OAuth providers
  providers: [
    "google",
    "github",
    "discord"
  ]

  # Roles available in the system
  roles: [
    "guest",
    "user",
    "moderator",
    "admin"
  ]
}

# ── Users ─────────────────────────────────

users: [
  {
    uid: 1
    name: "Alice"
    email: "alice@example.com"
    admin: true
    active: true
    score: 98.6
    nickname: null

    inventory: [
      "sword",
      "shield",
      "potion"
    ]

    settings: {
      theme: "dark"
      notifications: true
      language: "en"
    }
  }

  {
    uid: 2
    name: "Bob"
    email: "bob@example.com"
    admin: false
    active: true
    score: 74.2
    nickname: "bobby"

    inventory: [
      "bow",
      "arrows"
    ]

    settings: {
      theme: "light"
      notifications: false
      language: "fr"
    }
  }

  {
    uid: 3
    name: "Carol"
    email: "carol@example.com"
    admin: false
    active: false
    score: 0.0
    nickname: null

    # New user — inventory is empty
    inventory: []

    settings: {
      theme: "system"
      notifications: true
      language: "de"
    }
  }
]

# ── Feature flags ─────────────────────────

features: {
  new_dashboard: true
  legacy_api: false
  beta_editor: true
  analytics: true
  maintenance_mode: false
}

# ── Logging ───────────────────────────────

logging: {
  level: "info"
  pretty: false
  output: "stdout"
  max_file_size_mb: 100
  rotate: true

  # Fields to redact from logs
  redact: [
    "password",
    "token",
    "secret",
    "credit_card"
  ]
}

# ── Server limits ─────────────────────────

limits: {
  max_upload_mb: 25
  rate_limit_per_minute: 60
  max_body_size: 1048576
  request_timeout: 15.0
  enabled: true
  burst_allowance: null
}
